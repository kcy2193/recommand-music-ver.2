function spotifyUrl(song){
  const q = encodeURIComponent(song.artist + " " + song.title);
  return "https://open.spotify.com/search/" + q;
}

function renderMoodButtons(){
  moodButtonsEl.innerHTML = "";
  const allBtn = document.createElement('button');
  allBtn.className = 'mood-btn' + (activeMood === null ? ' active' : '');
  allBtn.type = 'button';
  allBtn.textContent = '전체';
  allBtn.addEventListener('click', () => { activeMood = null; render(); });
  moodButtonsEl.appendChild(allBtn);

  moods.forEach(m => {
    const btn = document.createElement('button');
    btn.className = 'mood-btn' + (activeMood === m ? ' active' : '');
    btn.type = 'button';
    btn.textContent = m;
    btn.addEventListener('click', () => { activeMood = m; render(); });
    moodButtonsEl.appendChild(btn);
  });
}

function getFilteredSongs(){
  return bandSongDatabase.filter(song => {
    const matchesMood = activeMood === null || song.mood === activeMood;
    const term = searchTerm.trim().toLowerCase();
    const matchesSearch = term === "" ||
      song.title.toLowerCase().includes(term) ||
      song.artist.toLowerCase().includes(term);
    return matchesMood && matchesSearch;
  });
}

function renderTrackList(){
  const songs = getFilteredSongs();
  listTitleEl.textContent = activeMood === null ? '전체 곡' : activeMood;
  trackCountEl.textContent = songs.length + '곡';
  trackListEl.innerHTML = "";

  if(songs.length === 0){
    const div = document.createElement('div');
    div.className = 'empty-state';
    div.textContent = '조건에 맞는 곡이 없어요. 다른 느낌이나 검색어로 찾아보세요.';
    trackListEl.appendChild(div);
    return;
  }

  songs.forEach((song, i) => {
    const globalIndex = bandSongDatabase.indexOf(song);
    const row = document.createElement('div');
    row.className = 'track' + (selectedIndex === globalIndex ? ' selected' : '');
    row.setAttribute('role','button');
    row.setAttribute('tabindex','0');

    const num = document.createElement('span');
    num.className = 'track-num';
    num.textContent = String(i + 1).padStart(2,'0');

    const info = document.createElement('div');
    info.className = 'track-info';
    const t = document.createElement('p');
    t.className = 'track-title';
    t.textContent = song.title;
    const a = document.createElement('p');
    a.className = 'track-artist';
    a.textContent = song.artist;
    info.appendChild(t);
    info.appendChild(a);

    const tag = document.createElement('span');
    tag.className = 'track-mood-tag';
    tag.textContent = song.mood.split(' / ')[0];

    const sp = document.createElement('button');
    sp.className = 'track-spotify';
    sp.type = 'button';
    sp.title = 'Spotify에서 듣기';
    sp.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.4c-.19.31-.6.4-.9.21-2.47-1.51-5.58-1.85-9.24-1.01-.35.08-.7-.14-.78-.49-.08-.35.14-.7.49-.78 4.01-.92 7.45-.52 10.22 1.17.31.19.4.6.21.9zm1.22-2.72c-.24.39-.75.51-1.14.27-2.83-1.74-7.14-2.24-10.49-1.23-.44.13-.9-.12-1.03-.55-.13-.44.12-.9.55-1.03 3.82-1.16 8.57-.6 11.83 1.4.39.24.51.75.28 1.14zm.11-2.83C14.39 8.75 8.65 8.55 5.44 9.53c-.52.16-1.07-.14-1.23-.65-.16-.52.14-1.07.65-1.23 3.68-1.12 10.02-.9 13.93 1.42.47.28.62.88.34 1.35-.28.46-.88.62-1.34.34z"/></svg>';
    sp.addEventListener('click', (e) => {
      e.stopPropagation();
      window.open(spotifyUrl(song), '_blank', 'noopener');
    });

    row.appendChild(num);
    row.appendChild(info);
    row.appendChild(tag);
    row.appendChild(sp);

    row.addEventListener('click', () => selectSong(globalIndex));
    row.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); selectSong(globalIndex); }
    });

    trackListEl.appendChild(row);
  });
}

function selectSong(globalIndex){
  selectedIndex = globalIndex;
  const song = bandSongDatabase[globalIndex];

  vinylLabelText.innerHTML = '<span class="t">' + escapeHtml(song.title) + '</span><span class="a">' + escapeHtml(song.artist) + '</span>';

  vinylDisc.classList.remove('spinning');
  void vinylDisc.offsetWidth;
  vinylDisc.classList.add('spinning');

  tonearm.classList.remove('down');
  void tonearm.offsetWidth;
  requestAnimationFrame(() => tonearm.classList.add('down'));

  nowPlayingEl.innerHTML =
    '<p class="np-label">NOW SPINNING</p>' +
    '<p class="np-title">' + escapeHtml(song.title) + '</p>' +
    '<p class="np-artist">' + escapeHtml(song.artist) + ' · ' + escapeHtml(song.mood) + '</p>' +
    '<a class="np-spotify" href="' + spotifyUrl(song) + '" target="_blank" rel="noopener">Spotify에서 듣기</a>';

  renderTrackList();
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function render(){
  renderMoodButtons();
  renderTrackList();
}

searchInput.addEventListener('input', (e) => {
  searchTerm = e.target.value;
  renderTrackList();
});

randomBtn.addEventListener('click', () => {
  const pool = getFilteredSongs();
  if(pool.length === 0) return;
  const pick = pool[Math.floor(Math.random() * pool.length)];
  const globalIndex = bandSongDatabase.indexOf(pick);
  selectSong(globalIndex);
});

render();
</script>
</body>
</html>
