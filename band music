<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>오늘의 밴드 노래 추천</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Song+Myung&family=Noto+Sans+KR:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#efe7d8;
    --ink-dim:#a89f8c;
    --bg:#141217;
    --bg-raised:#1b1820;
    --groove:#221f28;
    --vinyl:#0d0c10;
    --label:#e7a53c;
    --label-deep:#c47f1f;
    --wine:#b6432c;
    --line: rgba(239,231,216,0.14);
    --radius: 3px;
  }
  :root:not([data-theme="light"]){ color-scheme: dark; }

  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Noto Sans KR', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  body{
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    background-image:
      radial-gradient(circle at 15% 8%, rgba(231,165,60,0.07), transparent 45%),
      radial-gradient(circle at 85% 92%, rgba(182,67,44,0.08), transparent 40%);
  }

  ::selection{ background:var(--label); color:#141217; }

  .wrap{
    max-width:920px;
    margin:0 auto;
    padding:20px 20px 80px;
  }

  .topnav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:24px;
    flex-wrap:wrap;
  }
  .nav-links{ display:flex; gap:8px; flex-wrap:wrap; }
  .fwd-link{
    font-size:13px;
    color:var(--ink-dim);
    text-decoration:none;
    border:1px solid var(--line);
    border-radius:100px;
    padding:8px 14px;
    transition:border-color .15s ease, color .15s ease;
  }
  .fwd-link:hover{ color:var(--ink); border-color:var(--label-deep); }
  .site-mark{
    font-size:12px;
    color:var(--ink-dim);
    letter-spacing:0.02em;
  }

  /* ---------- HERO ---------- */
  .hero{
    display:flex;
    align-items:center;
    gap:28px;
    padding-bottom:30px;
    border-bottom:1px solid var(--line);
    margin-bottom:28px;
  }
  .hero-text{ flex:1; min-width:0; }
  .kicker{
    font-size:13px;
    letter-spacing:0.02em;
    color:var(--label);
    margin:0 0 8px;
  }
  h1{
    font-family:'Song Myung', serif;
    font-weight:400;
    font-size:clamp(28px,6vw,42px);
    line-height:1.25;
    margin:0 0 10px;
    color:var(--ink);
  }
  .hero-desc{
    margin:0;
    color:var(--ink-dim);
    font-size:14.5px;
    line-height:1.65;
    max-width:46ch;
  }

  .disc-badge{
    flex-shrink:0;
    width:96px; height:96px;
  }
  .disc-badge svg{ width:100%; height:100%; }
  .disc-badge .ring{ animation: spin 9s linear infinite; transform-origin:50% 50%; }
  @media (prefers-reduced-motion: reduce){ .disc-badge .ring{ animation:none; } }

  /* ---------- MOOD PILLS ---------- */
  .section-label{
    font-size:12.5px;
    color:var(--ink-dim);
    margin:0 0 12px;
  }
  .moods{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:26px;
  }
  .mood-btn{
    font-family:inherit;
    font-size:13.5px;
    color:var(--ink);
    background:var(--bg-raised);
    border:1px solid var(--line);
    padding:9px 15px;
    border-radius:100px;
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease, color .15s ease;
    white-space:nowrap;
  }
  .mood-btn:hover{ border-color:var(--label-deep); }
  .mood-btn:focus-visible{ outline:2px solid var(--label); outline-offset:2px; }
  .mood-btn.active{
    background:var(--label);
    border-color:var(--label);
    color:#1a1509;
    font-weight:600;
  }

  /* ---------- CONTROLS ---------- */
  .controls{
    display:flex;
    gap:10px;
    margin-bottom:28px;
    flex-wrap:wrap;
  }
  .search-box{
    flex:1;
    min-width:180px;
    position:relative;
  }
  .search-box input{
    width:100%;
    font-family:inherit;
    font-size:14px;
    color:var(--ink);
    background:var(--bg-raised);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:12px 14px;
  }
  .search-box input::placeholder{ color:var(--ink-dim); }
  .search-box input:focus-visible{ outline:2px solid var(--label); outline-offset:1px; }

  .random-btn{
    font-family:inherit;
    font-size:14px;
    font-weight:600;
    color:#1a1509;
    background:linear-gradient(180deg, var(--label), var(--label-deep));
    border:none;
    border-radius:var(--radius);
    padding:12px 18px;
    cursor:pointer;
    white-space:nowrap;
  }
  .random-btn:hover{ filter:brightness(1.06); }
  .random-btn:focus-visible{ outline:2px solid var(--ink); outline-offset:2px; }

  /* ---------- LAYOUT: PLAYER + LIST ---------- */
  .stage{
    display:grid;
    grid-template-columns: 220px 1fr;
    gap:30px;
    align-items:start;
  }
  @media (max-width:640px){
    .stage{ grid-template-columns:1fr; }
  }

  /* Turntable */
  .player{
    position:sticky;
    top:16px;
    background:var(--bg-raised);
    border:1px solid var(--line);
    border-radius:6px;
    padding:22px 18px 18px;
  }
  .platter{
    position:relative;
    width:100%;
    aspect-ratio:1/1;
    margin:0 auto 16px;
  }
  .vinyl-disc{
    position:absolute; inset:0;
    border-radius:50%;
    background:
      repeating-radial-gradient(circle at 50% 50%, var(--vinyl) 0 2px, #17151b 2px 4px);
    box-shadow: 0 10px 26px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(255,255,255,0.03);
    animation: spin 3.2s linear infinite;
    animation-play-state: paused;
  }
  .vinyl-disc.spinning{ animation-play-state: running; }
  @media (prefers-reduced-motion: reduce){ .vinyl-disc{ animation:none !important; } }

  .vinyl-label{
    position:absolute;
    left:50%; top:50%;
    width:38%; height:38%;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:var(--label);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:6%;
    box-shadow:0 0 0 1px rgba(0,0,0,0.3), 0 2px 8px rgba(0,0,0,0.4);
  }
  .vinyl-label-inner{
    font-size:9.5px;
    line-height:1.35;
    color:#1a1509;
    font-weight:700;
    overflow:hidden;
  }
  .vinyl-label-inner .t{ display:block; font-size:10.5px; margin-bottom:2px; }
  .vinyl-label-inner .a{ display:block; font-weight:500; opacity:0.85; font-size:9px; }
  .vinyl-spindle{
    position:absolute; left:50%; top:50%;
    width:6px; height:6px;
    transform:translate(-50%,-50%);
    background:#0a090c;
    border-radius:50%;
    z-index:2;
  }
  .tonearm{
    position:absolute;
    top:-6%; right:-8%;
    width:44%;
    height:44%;
    transform-origin: 88% 12%;
    transform: rotate(-24deg);
    transition: transform .5s cubic-bezier(.4,0,.2,1);
    pointer-events:none;
  }
  .tonearm.down{ transform: rotate(2deg); }
  .tonearm svg{ width:100%; height:100%; overflow:visible; }

  .now-playing{
    text-align:center;
  }
  .now-playing .np-label{
    font-size:11px;
    color:var(--ink-dim);
    margin:0 0 4px;
  }
  .now-playing .np-title{
    font-family:'Song Myung', serif;
    font-size:16px;
    margin:0 0 2px;
    color:var(--ink);
  }
  .now-playing .np-artist{
    font-size:12.5px;
    color:var(--ink-dim);
    margin:0 0 12px;
  }
  .np-spotify{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:12.5px;
    font-weight:600;
    color:#1a1509;
    background:#3fc464;
    border:none;
    border-radius:100px;
    padding:8px 14px;
    cursor:pointer;
    text-decoration:none;
  }
  .np-spotify:hover{ filter:brightness(1.05); }
  .np-empty{ font-size:12.5px; color:var(--ink-dim); line-height:1.6; }

  /* Track list */
  .list-head{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom:10px;
  }
  .track-count{ font-size:12px; color:var(--ink-dim); }

  .track-list{
    border-top:1px solid var(--line);
  }
  .track{
    display:flex;
    align-items:center;
    gap:14px;
    padding:13px 4px;
    border-bottom:1px solid var(--line);
    cursor:pointer;
    background:transparent;
    transition:background .12s ease;
  }
  .track:hover{ background:rgba(239,231,216,0.035); }
  .track.selected{ background:rgba(231,165,60,0.08); }
  .track-num{
    width:24px;
    flex-shrink:0;
    font-size:12px;
    color:var(--ink-dim);
    text-align:right;
    font-variant-numeric: tabular-nums;
  }
  .track-info{ flex:1; min-width:0; }
  .track-title{
    font-size:14.5px;
    color:var(--ink);
    margin:0 0 3px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .track-artist{
    font-size:12.5px;
    color:var(--ink-dim);
    margin:0;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .track-mood-tag{
    flex-shrink:0;
    font-size:11px;
    color:var(--ink-dim);
    border:1px solid var(--line);
    border-radius:100px;
    padding:4px 9px;
    display:none;
  }
  @media (min-width:560px){ .track-mood-tag{ display:inline-block; } }

  .track-spotify{
    flex-shrink:0;
    width:30px; height:30px;
    border-radius:50%;
    border:1px solid var(--line);
    background:var(--bg-raised);
    color:var(--ink-dim);
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
  }
  .track-spotify:hover{ border-color:#3fc464; color:#3fc464; }
  .track-spotify svg{ width:14px; height:14px; }

  .empty-state{
    padding:40px 10px;
    text-align:center;
    color:var(--ink-dim);
    font-size:13.5px;
  }

  @keyframes spin{ from{ transform:rotate(0deg); } to{ transform:rotate(360deg); } }
</style>
</head>
<body>
<div class="wrap">

  <div class="topnav">
    <span class="site-mark">TODAY'S PICK · 밴드</span>
